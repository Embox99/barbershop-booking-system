# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/barbershop_db"

# ── Auth ──────────────────────────────────────────────────────────────────────
# REQUIRED — generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-very-long-random-secret-here"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL="http://localhost:5173"

# ── Barbershop schedule (UTC, 24h) ────────────────────────────────────────────
WORK_START="10:00"
WORK_END="20:00"
SLOT_STEP_MINUTES=15
